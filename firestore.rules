// Independent people counter: emulator-tested rules.
// Deploy only to people-counter-system-aed75.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function managementTerminalId() { return request.auth.uid; }
    function counterManagerPath() {
      return /databases/$(database)/documents/counterManagers/$(request.auth.uid);
    }
    function anonymousManagerSession() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == "anonymous";
    }
    function counterOperator() {
      return anonymousManagerSession()
        && exists(counterManagerPath())
        && get(counterManagerPath()).data.enabled == true
        && get(counterManagerPath()).data.role in ["admin","subAdmin"];
    }
    function counterAdministrator() {
      return counterOperator() && get(counterManagerPath()).data.role == "admin";
    }
    // First administrator and subsequent account grants must be provisioned by a trusted backend/console.
    match /counterManagers/{uid} {
      allow get: if anonymousManagerSession() && request.auth.uid == uid;
      allow list: if counterAdministrator();
      allow write: if false;
    }
    function counterDevicePath(eventId) {
      return /databases/$(database)/documents/events/$(eventId)/counterDevices/$(request.auth.uid);
    }

    function counterAssignment(eventId, role) {
      return /databases/$(database)/documents/events/$(eventId)/counterAssignments/$(role);
    }

    function ownCounterAssignment(eventId) {
      let device = get(counterDevicePath(eventId)).data;
      return get(counterAssignment(eventId, device.role)).data.uid == request.auth.uid;
    }

    function approvedCounterDevice(eventId) {
      return signedIn() && exists(counterDevicePath(eventId))
        && get(counterDevicePath(eventId)).data.status == "approved"
        && exists(counterDayPath(eventId)) && ownCounterAssignment(eventId);
    }

    function counterMode(mode) {
      return mode in ["test", "live"];
    }

    function counterTime(value) {
      return value is number && value >= 0 && value <= 8640000000000000;
    }

    function validCounterConfig(data) {
      return data.keys().hasAll(["opened", "closed", "paused", "verified", "updatedAt", "updatedByUid"])
        && data.keys().hasOnly(["opened", "closed", "paused", "verified", "updatedAt", "updatedByUid", "version"])
        && (!data.keys().hasAny(["version"]) || (data.version is int && data.version >= 0))
        && (data.opened == null || (data.opened is int && counterTime(data.opened)))
        && (data.closed == null || (data.closed is int && counterTime(data.closed) && data.opened != null && data.closed >= data.opened))
        && data.paused is bool && data.verified is bool
        && (!data.verified || (data.opened != null && data.closed != null))
        && data.updatedAt == request.time && data.updatedByUid == request.auth.uid;
    }

    function validCounterDeviceName(name) {
      return name is string && name.size() > 0 && name.size() <= 80;
    }

    function validCounterDeviceId(id) {
      return id is string && id.matches("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$");
    }

    function counterOperationId(id) {
      return id is string && id.matches("^(ledger|edit):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$");
    }

    function counterRevisionSnapshot(data) {
      return data is map
        && data.keys().hasAll(["at", "direction", "person", "invalid", "clockWarning", "clockUncertainty"])
        && data.keys().hasOnly(["at", "direction", "person", "invalid", "clockWarning", "clockUncertainty"])
        && counterTime(data.at) && data.direction in ["in", "out"]
        && data.person in ["visitor", "staff"] && data.invalid is bool
        && (data.clockWarning == null || (data.clockWarning is string && data.clockWarning.size() <= 80))
        && (data.clockUncertainty == null || counterTime(data.clockUncertainty));
    }

    function validCounterPassage(data) {
      return data.keys().hasAll(["at", "direction", "person", "source", "invalid"])
        && data.keys().hasOnly(["id", "kind", "eventId", "mode", "device", "actorUid", "rawAt", "at", "createdAt",
          "station", "direction", "person", "source", "invalid", "clockWarning", "clockUncertainty", "reason", "sequence", "passageId", "configVersion"])
        && data.id.matches("^ledger:.*$")
        && counterTime(data.at) && data.direction in ["in", "out"]
        && data.person in ["visitor", "staff"] && data.source in ["auto", "manual"] && data.invalid == false
        && (!data.keys().hasAny(["configVersion"]) || (data.configVersion is int && data.configVersion >= 0))
        && (!data.keys().hasAny(["sequence"]) || (data.sequence is int && data.sequence > 0))
        && (!data.keys().hasAny(["passageId"]) || validCounterDeviceId(data.passageId))
        && (!data.keys().hasAny(["clockWarning"]) || (data.clockWarning is string && data.clockWarning.size() <= 80))
        && (!data.keys().hasAny(["clockUncertainty"]) || data.clockUncertainty == null || counterTime(data.clockUncertainty))
        && (!data.keys().hasAny(["reason"]) || (data.reason is string && data.reason.size() <= 180));
    }

    function validCounterRevision(data) {
      return data.keys().hasAll(["target", "parent", "before", "after", "reason", "resolves"])
        && data.keys().hasOnly(["id", "kind", "eventId", "mode", "device", "actorUid", "rawAt", "at", "createdAt",
          "station", "source", "target", "parent", "before", "after", "reason", "resolves"])
        && data.id.matches("^edit:.*$")
        && counterOperationId(data.target) && counterOperationId(data.parent) && data.target.matches("^ledger:.*$")
        && data.id != data.parent && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 180
        && data.resolves is list && data.resolves.size() <= 100
        && (!data.keys().hasAny(["at"]) || counterTime(data.at))
        && (!data.keys().hasAny(["source"]) || data.source == "manual")
        && counterRevisionSnapshot(data.before) && counterRevisionSnapshot(data.after);
    }

    match /counterClocks/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(["at", "eventId"])
        && request.resource.data.keys().hasOnly(["at", "eventId"])
        && request.resource.data.eventId is string && request.resource.data.eventId.size() > 0
        && request.resource.data.eventId.size() <= 160
        && (approvedCounterDevice(request.resource.data.eventId) || counterOperator())
        && request.resource.data.at == request.time;
    }

    function counterDayPath(id) {
      return /databases/$(database)/documents/counterDays/$(id);
    }

    function counterScopeExists(id) {
      return exists(counterDayPath(id));
    }

    function counterUuid(id) {
      return id is string && id.matches("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$");
    }

    function validCounterAudit(data) {
      return data.updatedAt == request.time && data.updatedByUid == request.auth.uid;
    }

    function counterStage(value) {
      return value in ["prepare", "trial", "open", "restricted", "closing", "finished"];
    }

    function counterWall(value) {
      return value == null || (value is int && counterTime(value)
        && value <= (request.time + duration.value(2, "m")).toMillis());
    }

    match /counterEvents/{id} {
      allow get, list: if counterOperator();
      allow create, update: if counterOperator() && counterUuid(id)
        && request.resource.data.keys().hasOnly(["name", "venue", "updatedAt", "updatedByUid"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.venue is string && request.resource.data.venue.size() > 0 && request.resource.data.venue.size() <= 100
        && validCounterAudit(request.resource.data);
    }

    match /counterDays/{id} {
      function validDay(data) {
        return data.keys().hasOnly(["eventId","date","start","end","stage","opened","trialOpened",
          "closing","ended","emptyConfirmed","finalized","version","operation","updatedAt","updatedByUid"])
          && counterUuid(data.eventId) && data.date is string && data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && id == data.eventId + "_" + data.date
          && data.start is string && data.start.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$")
          && data.end is string && data.end.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$")
          && int(data.start.split(":")[0]) * 60 + int(data.start.split(":")[1])
            < int(data.end.split(":")[0]) * 60 + int(data.end.split(":")[1]) && counterStage(data.stage)
          && counterWall(data.opened) && counterWall(data.trialOpened) && counterWall(data.closing)
          && counterWall(data.ended) && counterWall(data.emptyConfirmed) && counterWall(data.finalized)
          && data.version is int && validCounterAudit(data);
      }

      function validStep(old, next, command) {
        let diff = next.diff(old).affectedKeys();
        let core = ["stage","version","operation","updatedAt","updatedByUid"];
        return (command == "trial" && old.stage == "prepare" && next.stage == "trial"
                && next.trialOpened != null && (old.trialOpened == null || next.trialOpened == old.trialOpened)
                && diff.hasOnly(core.concat(["trialOpened"])))
          || (command == "prepare" && old.stage == "trial" && next.stage == "prepare" && diff.hasOnly(core))
          || (command == "open" && old.stage in ["prepare","trial"] && next.stage == "open"
                && next.opened != null && diff.hasOnly(core.concat(["opened"])))
          || (command == "restrict" && old.stage == "open" && next.stage == "restricted" && diff.hasOnly(core))
          || (command == "unrestrict" && old.stage == "restricted" && next.stage == "open" && diff.hasOnly(core))
          || (command == "close" && old.stage in ["open","restricted"] && next.stage == "closing"
                && next.closing != null && next.closing >= old.opened && diff.hasOnly(core.concat(["closing"])))
          || (command == "reopen" && old.stage == "closing" && next.stage == "open"
                && next.closing == null && diff.hasOnly(core.concat(["closing"])))
          || (command == "finish" && old.stage == "closing" && next.stage == "finished"
                && next.ended != null && next.ended >= old.closing && next.emptyConfirmed == next.ended
                && next.finalized == null && diff.hasOnly(core.concat(["ended","emptyConfirmed"])))
          || (command == "verify" && old.stage == "finished" && old.finalized == null && next.stage == "finished"
                && next.finalized != null && next.finalized >= old.ended && diff.hasOnly(core.concat(["finalized"])))
          || (command == "unverify" && counterAdministrator() && old.stage == "finished" && old.finalized != null
                && next.stage == "finished" && next.finalized == null && diff.hasOnly(core.concat(["finalized"])));
      }

      function withCounterAction(next) {
        let path = /databases/$(database)/documents/counterDays/$(id)/actions/$(next.operation);
        let action = getAfter(path).data;
        return counterUuid(next.operation) && !exists(path)
          && action.from == resource.data.stage && action.to == next.stage && action.version == next.version
          && validCounterAudit(action) && validStep(resource.data,next,action.command);
      }

      allow get, list: if counterOperator();
      allow create: if counterOperator() && validDay(request.resource.data)
        && existsAfter(/databases/$(database)/documents/counterEvents/$(request.resource.data.eventId))
        && request.resource.data.stage == "prepare" && request.resource.data.version == 0
        && request.resource.data.operation == "" && request.resource.data.opened == null
        && request.resource.data.trialOpened == null && request.resource.data.closing == null
        && request.resource.data.ended == null && request.resource.data.emptyConfirmed == null
        && request.resource.data.finalized == null;
      allow update: if counterOperator() && validDay(request.resource.data)
        && ((resource.data.stage == "prepare"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["start","end","updatedAt","updatedByUid"]))
          || (request.resource.data.version == resource.data.version + 1 && withCounterAction(request.resource.data)
            && getAfter(/databases/$(database)/documents/events/$(id)/counterConfig/live).data.version == request.resource.data.version
            && getAfter(/databases/$(database)/documents/events/$(id)/counterConfig/test).data.version == request.resource.data.version));

      match /actions/{operation} {
        allow get, list: if counterOperator();
        allow create: if counterOperator() && counterUuid(operation)
          && request.resource.data.keys().hasOnly(["from","to","command","version","updatedAt","updatedByUid"])
          && validCounterAudit(request.resource.data)
          && getAfter(counterDayPath(id)).data.operation == operation
          && getAfter(counterDayPath(id)).data.version == get(counterDayPath(id)).data.version + 1;
      }
    }

    match /events/{eventId} {
      match /counterAssignments/{role} {
        allow get: if counterOperator();
        allow create, update: if counterOperator() && exists(counterDayPath(eventId)) && role in ["in","out"]
          && request.resource.data.keys().hasOnly(["uid","updatedAt","updatedByUid"])
          && validCounterAudit(request.resource.data)
          && (request.resource.data.uid == null
            ? (resource != null && resource.data.uid is string &&
              (getAfter(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(resource.data.uid)).data.status != "approved"
                || getAfter(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(resource.data.uid)).data.role != role))
            : (request.resource.data.uid is string && request.resource.data.uid.size() <= 160
              && (resource == null || resource.data.uid == null || resource.data.uid == request.resource.data.uid)
              && getAfter(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(request.resource.data.uid)).data.status == "approved"
              && getAfter(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(request.resource.data.uid)).data.role == role));
      }

      // Pairing reservations are addressed only by a six-digit code. Only the
      // issuing device or an operator with a recent lookup can read a reservation.
      match /counterPairAttempts/{uid} {
        allow create, update: if counterOperator() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["code","at"])
          && request.resource.data.code is string && request.resource.data.code.matches("^[0-9]{6}$")
          && request.resource.data.at == request.time
          && (resource == null || resource.data.at + duration.value(3,"s") <= request.time);
      }

      match /counterPairCodes/{code} {
        function attemptedCode(seconds) {
          let attempt = get(/databases/$(database)/documents/events/$(eventId)/counterPairAttempts/$(request.auth.uid)).data;
          return attempt.code == code && attempt.at + duration.value(seconds,"s") > request.time;
        }
        function validReservation(data) {
          let station = getAfter(counterDevicePath(eventId)).data;
          return code.matches("^[0-9]{6}$") && data.keys().hasOnly(["uid","device","issuedAt","usedAt"])
            && data.uid == request.auth.uid && data.device == station.device
            && data.issuedAt == request.time && data.usedAt == null
            && station.status == "pending" && station.pairingIssuedAt == request.time
            && (resource == null || resource.data.issuedAt + duration.value(5,"m") <= request.time);
        }
        function consumeReservation() {
          let station = getAfter(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(resource.data.uid)).data;
          return counterOperator() && attemptedCode(300) && resource.data.usedAt == null
            && resource.data.issuedAt + duration.value(5,"m") > request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usedAt"])
            && request.resource.data.usedAt == request.time
            && station.status == "approved" && station.pairingConfirmed == code
            && station.pairingIssuedAt == resource.data.issuedAt && station.device == resource.data.device;
        }
        allow get: if (signedIn() && resource != null && request.auth.uid == resource.data.uid)
          || (counterOperator() && attemptedCode(30)
            && (resource == null || (resource.data.usedAt == null
              && resource.data.issuedAt + duration.value(5,"m") > request.time)));
        allow create: if signedIn() && exists(counterDayPath(eventId)) && validReservation(request.resource.data);
        allow update: if (signedIn() && exists(counterDayPath(eventId)) && validReservation(request.resource.data))
          || consumeReservation();
      }

      match /counterCommands/{uid} {
        function currentStation() {
          return get(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(uid)).data;
        }
        function commandMatchesStation(data) {
          let station = currentStation();
          return station.status == "approved" && station.device == data.device && station.role == data.role
            && station.updatedAt == data.assignment && station.mode == data.mode
            && get(counterAssignment(eventId,data.role)).data.uid == uid
            && get(/databases/$(database)/documents/events/$(eventId)/counterConfig/$(data.mode)).data.version == data.configVersion;
        }
        function validIssuedCommand(data) {
          return exists(counterDayPath(eventId)) && data.keys().hasOnly([
              "id","device","role","mode","configVersion","assignment","action","state","issuedAt","issuedBy"
            ]) && data.id is string && data.id.matches("^[a-f0-9-]{36}$")
            && data.role in ["in","out"] && counterMode(data.mode) && data.configVersion is int
            && data.action in ["diagnose","sync","stop","camera","engine","recalibrate"]
            && data.state == "issued" && data.issuedAt == request.time && data.issuedBy == request.auth.uid
            && commandMatchesStation(data);
        }
        function recordStarted(data) {
          return resource.data.state == "issued" && data.state == "running"
            && resource.data.issuedAt + duration.value(2,"m") > request.time
            && data.diff(resource.data).affectedKeys().hasOnly(["state","startedAt"])
            && data.startedAt == request.time && commandMatchesStation(resource.data);
        }
        function recordFinished(data) {
          return resource.data.state == "running" && data.state == "finished"
            && data.diff(resource.data).affectedKeys().hasOnly(["state","result","finishedAt","downtimeMs"])
            && data.result in ["ok","busy","local","interrupted","stale","failed"]
            && (!("downtimeMs" in data) || (data.action in ["camera","engine"] && data.result == "ok"
              && data.downtimeMs is int && data.downtimeMs >= 0 && data.downtimeMs <= 240000))
            && data.finishedAt == request.time;
        }
        function replaceCommand(data) {
          return data.id != resource.data.id &&
            (resource.data.state == "finished"
              || (resource.data.state == "issued" && resource.data.issuedAt + duration.value(2,"m") <= request.time)
              || (resource.data.state == "running" && resource.data.startedAt + duration.value(4,"m") <= request.time))
            && getAfter(/databases/$(database)/documents/events/$(eventId)/counterCommands/$(uid)/history/$(resource.data.id)).data == resource.data;
        }
        allow get: if counterOperator() || (signedIn() && request.auth.uid == uid && approvedCounterDevice(eventId));
        allow create: if counterOperator() && validIssuedCommand(request.resource.data);
        allow update: if (counterOperator() && validIssuedCommand(request.resource.data) && replaceCommand(request.resource.data))
          || (signedIn() && request.auth.uid == uid && approvedCounterDevice(eventId)
            && (recordStarted(request.resource.data) || recordFinished(request.resource.data)));
        match /history/{commandId} {
          allow get, list: if counterOperator();
          allow create: if counterOperator()
            && commandId == get(/databases/$(database)/documents/events/$(eventId)/counterCommands/$(uid)).data.id
            && request.resource.data == get(/databases/$(database)/documents/events/$(eventId)/counterCommands/$(uid)).data
            && getAfter(/databases/$(database)/documents/events/$(eventId)/counterCommands/$(uid)).data.id != commandId;
        }
      }

      match /counterDevices/{uid} {
        function ownCounterDevice() {
          return signedIn() && request.auth.uid == uid;
        }

        function validLuxnoraActivity(activity) {
          return activity == null || (activity is map && activity.keys().hasOnly(["reason","state","at"])
            && activity.reason in ["camera","inference","storage"]
            && activity.state in ["recovering","verified","failed"]
            && activity.at is int && counterTime(activity.at));
        }

        function validLuxnoraStatus(status) {
          return status == null || (status is map && status.keys().hasOnly(["fps","inferenceMs","activity"])
            && (status.fps == null || (status.fps is number && status.fps >= 0 && status.fps <= 240))
            && (status.inferenceMs == null || (status.inferenceMs is int && status.inferenceMs >= 0 && status.inferenceMs <= 60000))
            && validLuxnoraActivity(status.activity));
        }

        function validCounterHeartbeat(data) {
          return data.diff(resource.data).affectedKeys().hasOnly([
              "lastSeen", "version", "camera", "ai", "profile", "pending", "alert", "mode", "configVersion", "lux"
            ])
            && data.lastSeen == request.time && data.version is string && data.version.matches("^[0-9]{1,6}$")
            && data.camera is bool && data.ai is bool && counterMode(data.mode) && validLuxnoraStatus(data.get("lux",null))
            && (data.get("configVersion", null) == null || (data.configVersion is int && data.configVersion >= 0
              && data.configVersion <= get(/databases/$(database)/documents/events/$(eventId)/counterConfig/$(data.mode)).data.version))
            && data.profile in ["baseline", "detail", "lighting", "unknown"]
            && data.pending is int && data.pending >= 0 && data.pending <= 1000000
            && data.alert in ["none", "paused", "setup", "recalibrate", "camera", "storage", "network"];
        }

        function validCounterDeviceDecision(data) {
          return data.diff(resource.data).affectedKeys().hasOnly(["name", "role", "status", "updatedAt", "updatedByUid", "pairingConfirmed"])
            && validCounterDeviceName(data.name) && data.role in ["in", "out"]
            && data.status in ["pending", "approved", "rejected", "revoked"]
            && (data.role == resource.data.role || resource.data.status != "approved"
              || (resource.data.get("lastSeen", timestamp.date(1970, 1, 1)) > request.time - duration.value(3, "m")
                && resource.data.get("pending", -1) == 0 && resource.data.get("camera", true) == false))
            && data.updatedAt == request.time && data.updatedByUid == request.auth.uid;
        }

        function matchesPairing(data) {
          let code = data.get("pairingConfirmed", "");
          let pairing = getAfter(/databases/$(database)/documents/events/$(eventId)/counterPairCodes/$(code)).data;
          return code.matches("^[0-9]{6}$") && pairing.uid == uid && pairing.device == resource.data.device
            && pairing.usedAt == request.time && pairing.issuedAt == resource.data.pairingIssuedAt;
        }

        allow get: if ownCounterDevice() || counterOperator();
        allow list: if counterOperator();
        allow create: if ownCounterDevice() && counterScopeExists(eventId)
          && request.resource.data.keys().hasAll(["name", "device", "role", "status", "requestedAt"])
          && request.resource.data.keys().hasOnly(["name", "device", "role", "status", "requestedAt", "pairingIssuedAt"])
          && (exists(counterDayPath(eventId))
            ? request.resource.data.pairingIssuedAt == request.time : !("pairingIssuedAt" in request.resource.data))
          && validCounterDeviceName(request.resource.data.name) && validCounterDeviceId(request.resource.data.device)
          && request.resource.data.role in ["in", "out"] && request.resource.data.status == "pending"
          && request.resource.data.requestedAt == request.time;
        function assignmentMatches(data) {
          return (data.status != "approved" || getAfter(counterAssignment(eventId,data.role)).data.uid == uid)
            && (resource.data.status != "approved" || (data.status == "approved" && data.role == resource.data.role)
              || getAfter(counterAssignment(eventId,resource.data.role)).data.uid == null);
        }

        allow update: if (ownCounterDevice() && approvedCounterDevice(eventId) && validCounterHeartbeat(request.resource.data))
          || (ownCounterDevice() && exists(counterDayPath(eventId)) && resource.data.status in ["pending","rejected","revoked"] && request.resource.data.status == "pending"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pairingIssuedAt","pairingConfirmed","status"])
            && !("pairingConfirmed" in request.resource.data)
            && request.resource.data.pairingIssuedAt == request.time
            && resource.data.get("pairingIssuedAt", timestamp.date(1970,1,1)) + duration.value(30,"s") <= request.time)
          || (exists(counterDayPath(eventId)) && counterOperator()
            && validCounterDeviceDecision(request.resource.data)
            && assignmentMatches(request.resource.data)
            && (request.resource.data.status != "approved" || resource.data.status == "approved"
              || (resource.data.status == "pending" && matchesPairing(request.resource.data)))
            && (counterAdministrator() || (resource.data.status in ["pending","approved"]
              && request.resource.data.status in ["pending","approved","rejected"]
              && (resource.data.status != "approved" || request.resource.data.status == "approved"))));

      }

      match /counterConfig/{mode} {
        allow get: if counterMode(mode) && (approvedCounterDevice(eventId) || counterOperator());
        function matchesCounterDay(data) {
          let day = getAfter(counterDayPath(eventId)).data;
          return validCounterAudit(day) && data.version == day.version
            && (mode == "live"
              ? data.opened == day.opened && data.closed == day.ended && data.verified == (day.finalized != null)
                && data.paused == !(day.stage in ["open","restricted","closing"])
              : data.opened == day.trialOpened && data.closed == null && data.verified == false
                && data.paused == (day.stage != "trial"));
        }
        allow create, update: if counterMode(mode) && validCounterConfig(request.resource.data)
          && existsAfter(counterDayPath(eventId)) && counterOperator() && matchesCounterDay(request.resource.data);

      }

      match /counterRuns/{mode}/operations/{operationId} {
        function validOperation(data) {
          return data is map
            && data.keys().hasAll(["id", "kind", "eventId", "mode", "device", "rawAt", "station"])
            && data.id == operationId && counterOperationId(data.id) && data.eventId == eventId && data.mode == mode
            && data.device is string && data.device.size() > 0 && data.device.size() <= 160
            && data.station in ["in", "out"] && counterTime(data.rawAt)
            && (!data.keys().hasAny(["createdAt"]) || counterTime(data.createdAt));
        }

        function autoCounterOperation(data) {
          return approvedCounterDevice(eventId)
            && data.kind == "passage" && validCounterPassage(data) && data.source == "auto" && data.person == "visitor"
            && data.device == get(counterDevicePath(eventId)).data.device
            && data.station == get(counterDevicePath(eventId)).data.role && data.direction == data.station
            && (!data.keys().hasAny(["actorUid"]) || data.actorUid == request.auth.uid);
        }

        function manualCounterOperation(data) {
          return counterOperator() && data.actorUid == request.auth.uid
            && (data.device == managementTerminalId() || data.device == request.auth.uid)
            && ((data.kind == "passage" && validCounterPassage(data) && data.source == "manual")
              || (data.kind == "revision" && validCounterRevision(data)));
        }

        function restoreCounterOperation(data) {
          let config = /databases/$(database)/documents/events/$(eventId)/counterConfig/$(mode);
          return counterAdministrator() && request.resource.data.restoredByUid == request.auth.uid
            && exists(config) && get(config).data.verified == false
            && (get(config).data.paused == true || (get(config).data.closed is number
              && get(config).data.closed <= request.time.toMillis()))
            && (!("actorUid" in data) || (data.actorUid is string && data.actorUid.matches("^[A-Za-z0-9_-]{1,160}$")))
            && ((data.kind == "passage" && validCounterPassage(data)
              && (data.source == "manual" || (data.person == "visitor" && data.direction == data.station)))
              || (data.kind == "revision" && validCounterRevision(data)));
        }
        allow get, list: if counterMode(mode) && (approvedCounterDevice(eventId) || counterOperator());
        allow create: if counterMode(mode) && counterScopeExists(eventId)
          && request.resource.data.receivedAt == request.time
          && validOperation(request.resource.data.payload)
          && ((request.resource.data.keys().hasOnly(["payload","receivedAt"])
            && (autoCounterOperation(request.resource.data.payload) || manualCounterOperation(request.resource.data.payload)))
            || (request.resource.data.keys().hasOnly(["payload","receivedAt","restoredByUid"])
              && restoreCounterOperation(request.resource.data.payload)));
      }

    }
    match /{document=**} { allow read, write: if false; }
  }
}
