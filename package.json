{
  "name": "people-counter-system",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p management-app/tsconfig.app.json && tsc --noEmit -p counter-app/tsconfig.app.json && vite build --config counter-app/vite.config.ts",
    "test": "node --test *counter*.test.mjs adaptive-*.test.mjs luxnora*.test.mjs",
    "evaluate:luxnora:v41": "node scripts/evaluate-luxnora-language-v41.mjs",
    "evaluate:luxnora:v4": "node scripts/evaluate-luxnora-v4.mjs",
    "evaluate:luxnora:reasoning": "node scripts/evaluate-luxnora-reasoning.mjs",
    "evaluate:luxnora": "node scripts/evaluate-luxnora.mjs",
    "test:rules": "firebase emulators:exec --project demo-people-counter --only firestore --config firebase.test.json \"node --test --test-concurrency=1 tests/*.test.mjs\""
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "fake-indexeddb": "^6.0.0",
    "react-test-renderer": "^19.2.7",
    "@types/node": "^22.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "@types/qrcode": "^1.5.5"
  }
}
